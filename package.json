{
  "name": "republik",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite apps/mobile --host 0.0.0.0",
    "build": "tsc --noEmit && vite build apps/mobile",
    "lint": "eslint .",
    "test": "vitest run",
    "assets:validate": "tsx scripts/characters.ts",
    "assets:extract": "tsx scripts/characters.ts --extract",
    "mobile:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
